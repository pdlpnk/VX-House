model Appeal {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @db.Uuid
  conversationId     String?               @db.Uuid
  userTaskId         String?               @db.Uuid
  submissionReviewId String?               @db.Uuid
  trustScoreEventId  String?               @db.Uuid
  rewardId           String?               @db.Uuid
  status             AppealStatus          @default(DRAFT)
  reason             String                @db.Text
  decisionReason     String?               @db.Text
