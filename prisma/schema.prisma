}

model TaskVersionAudience {
  taskVersionId String      @db.Uuid
  productRole   ProductRole
  marketId      String      @db.Uuid
  taskVersion   TaskVersion @relation(fields: [taskVersionId], references: [id], onDelete: Cascade)
  market        Market      @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@id([taskVersionId, productRole, marketId])
  @@index([productRole, marketId])
}

model UserTask {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @db.Uuid
  taskDefinitionId String                  @db.Uuid
  taskVersionId    String                  @db.Uuid
  attemptNumber    Int                     @default(1)
  status           UserTaskStatus          @default(AVAILABLE)
  assignmentKey    String                  @unique @db.VarChar(160)
  acceptedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  expiresAt        DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  taskDefinition   TaskDefinition          @relation(fields: [taskDefinitionId], references: [id], onDelete: Restrict)
  taskVersion      TaskVersion             @relation(fields: [taskVersionId], references: [id], onDelete: Restrict)
  submissions      TaskSubmission[]
  statusHistory    UserTaskStatusHistory[]
  pointsEntries    VXPointsLedgerEntry[]
  rewards          VXReward[]
  appeals          Appeal[]

  @@unique([userId, taskDefinitionId, attemptNumber])
  @@index([userId, status, createdAt])
  @@index([taskVersionId])
}

model UserTaskStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  userTaskId String          @db.Uuid
  fromStatus UserTaskStatus?
  toStatus   UserTaskStatus
  actorId    String?         @db.Uuid
