  userTask   UserTask            @relation(fields: [userTaskId], references: [id], onDelete: Restrict)
  versions   SubmissionVersion[]

  @@unique([userTaskId])
  @@index([userTaskId, createdAt])
}

model SubmissionVersion {
  id               String             @id @default(uuid()) @db.Uuid
  taskSubmissionId String             @db.Uuid
  version          Int
  status           SubmissionStatus   @default(DRAFT)
  payload          Json
