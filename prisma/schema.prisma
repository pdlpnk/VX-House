  @@unique([taskSubmissionId, version])
  @@index([status, submittedAt])
}

model SubmissionReview {
  id                  String            @id @default(uuid()) @db.Uuid
  submissionVersionId String            @db.Uuid
  reviewerId          String            @db.Uuid
