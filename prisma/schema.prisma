  decidedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation       SupportConversation?  @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  userTask           UserTask?             @relation(fields: [userTaskId], references: [id], onDelete: Restrict)
