  userTask   UserTask        @relation(fields: [userTaskId], references: [id], onDelete: Restrict)

  @@index([userTaskId, occurredAt])
}

model TaskSubmission {
  id         String              @id @default(uuid()) @db.Uuid
  userTaskId String              @db.Uuid
