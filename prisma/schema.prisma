generator client {
  provider     = "prisma-client"
  output       = "../lib/db/generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// Dedicated edge client retained for the Cloudflare build. The Ubuntu/PM2
// standalone server uses the Node.js client above.
generator edgeClient {
  provider     = "prisma-client"
  output       = "../lib/db/generated-edge"
  moduleFormat = "esm"
  runtime      = "workerd"
}

// Node-only client for isolated integration tests. The application keeps the
// workerd target required by the production runtime.
generator testClient {
  provider     = "prisma-client"
  output       = "../lib/db/generated-node"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum ProductRole {
  PLAYER
  PARTNER
}

enum MarketCode {
  TR
  AZ
}

enum LanguageCode {
  EN
  RU
  TR
  AZ
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ContactVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum OnboardingStatus {
  ACCOUNT_CREATED
  CONTACT_PENDING
  CONTACT_VERIFIED
  CONSENTS_PENDING
  PROFILE_READY
  PARTNER_APPROVAL_PENDING
  COMPLETED
}

enum PartnerProfileStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum OpportunityType {
  TASK
  INSTRUCTION
  PROMOCODE
  FORECAST
  PERSONAL_CONDITION
}

enum EligibilityStatus {
  ELIGIBLE
  INELIGIBLE
  PENDING
  EXPIRED
}

enum UserTaskStatus {
  AVAILABLE
  ACCEPTED
  IN_PROGRESS
  AWAITING_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  CLARIFICATION_REQUIRED
  RESUBMISSION_REQUIRED
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
}

enum ReviewDecision {
  CLARIFICATION_REQUIRED
  RESUBMISSION_REQUIRED
  CONFIRMED
  REJECTED
}

enum PointsEntryStatus {
  PENDING
  CONFIRMED
  REVERSED
}

enum RankCode {
  EXPLORER
  NAVIGATOR
  ATLAS
  PRIME
  SIGNATURE
}

enum RewardValueKind {
  MONETARY
  NON_MONETARY
}

enum RewardStatus {
  EXPECTED
  AWAITING_CONFIRMATION
  CONFIRMED
  PREPARING
  AVAILABLE
  PROVIDED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum SupportConversationStatus {
  CREATED
  ASSIGNED
  WAITING_OPERATOR
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportMessageAuthorType {
  USER
  OPERATOR
  SYSTEM
}

enum AppealStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  PARTIALLY_UPHELD
  DENIED
  CANCELLED
}

enum ForecastPublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SUPERSEDED
  RETRACTED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
  CANCELLED
}

enum PromocodeActivationStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum AnalyticsEventName {
  LANDING_VIEWED
  ACCESS_CLICKED
  REGISTRATION_STARTED
  EMAIL_CONFIRMED
  DASHBOARD_OPENED
}

enum ConversionDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  DELIVERED
  SKIPPED
  EXHAUSTED
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  email                       String                       @unique @db.VarChar(320)
  displayName                 String?                      @db.VarChar(120)
  passwordHash                String?                      @db.VarChar(255)
  passwordChangedAt           DateTime?
  disabledAt                  DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  sessions                    Session[]
  roles                       Role[]
  profile                     UserProfile?
  approvedPartners            PartnerProfile[]             @relation("PartnerApprover")
  managedTasks                TaskDefinition[]             @relation("TaskManager")
  reviewDecisions             SubmissionReview[]           @relation("SubmissionReviewer")
  authoredForecasts           Forecast[]                   @relation("ForecastAuthor")
  assignedSupport             SupportConversation[]        @relation("SupportAssignee")
  supportMessages             SupportMessage[]             @relation("SupportMessageAuthor")
  supportNotes                SupportInternalNote[]        @relation("SupportNoteAuthor")
  appealDecisions             Appeal[]                     @relation("AppealReviewer")
  notifications               Notification[]
  userConsents                UserConsent[]
  opportunityEligibilities    OpportunityEligibility[]
  userTasks                   UserTask[]
  vxPointsLedgerEntries       VXPointsLedgerEntry[]
  userRanks                   UserRank[]
  trustScoreEvents            TrustScoreEvent[]
  trustScoreSnapshot          TrustScoreSnapshot?
  vxRewards                   VXReward[]
  supportConversations        SupportConversation[]
  appeals                     Appeal[]
  idempotencyRecords          IdempotencyRecord[]
  onboardingProgress          OnboardingProgress?
  emailVerificationChallenges EmailVerificationChallenge[]
  passwordResetChallenges     PasswordResetChallenge[]
  accountStatusHistory        UserAccountStatusHistory[]   @relation("AccountStatusUser")
  accountStatusChanges        UserAccountStatusHistory[]   @relation("AccountStatusActor")
  partnerApprovalChanges      PartnerApprovalHistory[]     @relation("PartnerApprovalActor")
  contentRevisions            AdminContentRevision[]       @relation("AdminContentAuthor")
  notificationBatches         NotificationBatch[]          @relation("NotificationBatchActor")
  forecastAccessRules         ForecastAccessRule[]
  promocodeActivations        PromocodeActivation[]
  analyticsSessions           AnalyticsSession[]
  analyticsEvents             AnalyticsEvent[]

  @@index([createdAt])
}

model OnboardingProgress {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @db.Uuid
  status         OnboardingStatus @default(ACCOUNT_CREATED)
  ageConfirmedAt DateTime?
  profileReadyAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model EmailVerificationChallenge {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  codeHash          String    @db.Char(64)
  attemptCount      Int       @default(0)
  maxAttempts       Int
  expiresAt         DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  codeHash          String    @db.Char(64)
  attemptCount      Int       @default(0)
  maxAttempts       Int
  expiresAt         DateTime
  resendAvailableAt DateTime
  verifiedAt        DateTime?
  resetTokenHash    String?   @unique @db.VarChar(128)
  resetExpiresAt    DateTime?
  consumedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @db.VarChar(128)
  userId            String    @db.Uuid
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastSeenAt        DateTime?
  refreshedAt       DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([absoluteExpiresAt])
}

model AnalyticsSession {
  id           String           @id @default(uuid()) @db.Uuid
  anonymousId  String           @unique @db.VarChar(64)
  userId       String?          @db.Uuid
  keitaroSubId String?          @db.VarChar(255)
  firstTouch   Json
  isTest       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events       AnalyticsEvent[]

  @@index([userId, createdAt])
  @@index([keitaroSubId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  eventName          AnalyticsEventName
  analyticsSessionId String?              @db.Uuid
  userId             String?              @db.Uuid
  authSessionId      String?              @db.Uuid
  metadata           Json
  occurredAt         DateTime             @default(now())
  idempotencyKey     String               @unique @db.VarChar(200)
  isTest             Boolean              @default(false)
  analyticsSession   AnalyticsSession?    @relation(fields: [analyticsSessionId], references: [id], onDelete: SetNull)
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries         ConversionDelivery[]

  @@index([eventName, occurredAt])
  @@index([analyticsSessionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([authSessionId, eventName])
}

model ConversionDelivery {
  id                    String                   @id @default(uuid()) @db.Uuid
  eventId               String                   @db.Uuid
  provider              String                   @db.VarChar(40)
  status                ConversionDeliveryStatus @default(PENDING)
  providerStatus        String                   @db.VarChar(80)
  transactionId         String                   @unique @db.VarChar(200)
  attemptCount          Int                      @default(0)
  nextAttemptAt         DateTime                 @default(now())
  lastErrorSafe         String?                  @db.VarChar(500)
  deliveredAt           DateTime?
  providerTransactionId String?                  @db.VarChar(255)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  event                 AnalyticsEvent           @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, provider])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique @db.VarChar(100)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions Permission[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(160)
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorType      String   @db.VarChar(32)
  actorId        String?  @db.VarChar(128)
  actorSessionId String?  @db.Uuid
  action         String   @db.VarChar(160)
  targetType     String   @db.VarChar(120)
  targetId       String?  @db.VarChar(160)
  occurredAt     DateTime @default(now())
  metadata       Json

  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([targetType, targetId])
  @@index([occurredAt])
}

model RateLimitBucket {
  keyHash         String   @id @db.VarChar(64)
  requestCount    Int
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model Market {
  id                String                 @id @default(uuid()) @db.Uuid
  code              MarketCode             @unique
  name              String                 @db.VarChar(120)
  defaultLanguage   LanguageCode
  isActive          Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  profiles          UserProfile[]
  serviceMarkets    PartnerServiceMarket[]
  opportunityScopes OpportunityAudience[]
  instructionScopes InstructionAudience[]
  taskScopes        TaskVersionAudience[]
  rankDefinitions   RankDefinition[]
  economyPolicies   EconomyPolicy[]
  promocodes        Promocode[]
  forecastRules     ForecastAccessRule[]
  consentVersions   ConsentVersion[]
  supportCategories SupportCategory[]
}

model SupportCategory {
  id            String                @id @default(uuid()) @db.Uuid
  key           String                @unique @db.VarChar(80)
  title         String                @db.VarChar(160)
  description   String                @db.Text
  roles         Json
  marketId      String?               @db.Uuid
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  market        Market?               @relation(fields: [marketId], references: [id], onDelete: Restrict)
  conversations SupportConversation[]

  @@index([marketId, isActive])
}

model EconomyPolicy {
  id                 String            @id @default(uuid()) @db.Uuid
  scopeKey           String            @db.VarChar(120)
  version            Int
  productRole        ProductRole?
  marketId           String?           @db.Uuid
  status             PublicationStatus @default(DRAFT)
  startingTrustScore Int
  pointsRules        Json
  trustRules         Json
  trustZones         Json
  effectiveFrom      DateTime?
  effectiveUntil     DateTime?
  createdAt          DateTime          @default(now())
  market             Market?           @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, version])
  @@index([productRole, marketId, status, effectiveFrom])
}

model UserProfile {
  id                        String                     @id @default(uuid()) @db.Uuid
  userId                    String                     @unique @db.Uuid
  productRole               ProductRole
  marketId                  String                     @db.Uuid
  preferredLanguage         LanguageCode
  contactVerificationStatus ContactVerificationStatus  @default(UNVERIFIED)
  contactVerifiedAt         DateTime?
  accountStatus             AccountStatus              @default(PENDING)
  accountStatusReason       String?                    @db.VarChar(500)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  market                    Market                     @relation(fields: [marketId], references: [id], onDelete: Restrict)
  playerProfile             PlayerProfile?
  partnerProfile            PartnerProfile?
  statusHistory             UserAccountStatusHistory[]

  @@index([productRole, marketId, accountStatus])
  @@index([contactVerificationStatus])
}

model UserAccountStatusHistory {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  userProfileId String        @db.Uuid
  actorId       String        @db.Uuid
  fromStatus    AccountStatus
  toStatus      AccountStatus
  reason        String        @db.VarChar(1000)
  occurredAt    DateTime      @default(now())
  user          User          @relation("AccountStatusUser", fields: [userId], references: [id], onDelete: Restrict)
  userProfile   UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  actor         User          @relation("AccountStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([actorId, occurredAt])
}

model PlayerProfile {
  id                  String        @id @default(uuid()) @db.Uuid
  userProfileId       String        @unique @db.Uuid
  participationStatus AccountStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  userProfile         UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model PartnerProfile {
  id              String                   @id @default(uuid()) @db.Uuid
  userProfileId   String                   @unique @db.Uuid
  status          PartnerProfileStatus     @default(PENDING)
  statusReason    String?                  @db.VarChar(500)
  approvedById    String?                  @db.Uuid
  approvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  userProfile     UserProfile              @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  approvedBy      User?                    @relation("PartnerApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalHistory PartnerApprovalHistory[]

  @@index([status])
  @@index([approvedById])
}

model PartnerApprovalHistory {
  id               String               @id @default(uuid()) @db.Uuid
  partnerProfileId String               @db.Uuid
  actorId          String               @db.Uuid
  fromStatus       PartnerProfileStatus
  toStatus         PartnerProfileStatus
  reason           String               @db.VarChar(1000)
  occurredAt       DateTime             @default(now())
  partnerProfile   PartnerProfile       @relation(fields: [partnerProfileId], references: [id], onDelete: Restrict)
  actor            User                 @relation("PartnerApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([partnerProfileId, occurredAt])
  @@index([actorId, occurredAt])
}

model AdminContentRevision {
  id          String            @id @default(uuid()) @db.Uuid
  entityType  String            @db.VarChar(80)
  entityId    String            @db.Uuid
  version     Int
  status      PublicationStatus @default(DRAFT)
  snapshot    Json
  reason      String            @db.VarChar(1000)
  createdById String            @db.Uuid
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  createdBy   User              @relation("AdminContentAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([entityType, entityId, version])
  @@index([entityType, status, createdAt])
  @@index([createdById, createdAt])
}

model ConsentDocument {
  id         String           @id @default(uuid()) @db.Uuid
  key        String           @unique @db.VarChar(120)
  title      String           @db.VarChar(200)
  isRequired Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  versions   ConsentVersion[]
}

model ConsentVersion {
  id                String          @id @default(uuid()) @db.Uuid
  consentDocumentId String          @db.Uuid
  marketId          String          @db.Uuid
  version           Int
  language          LanguageCode
  contentHash       String          @db.VarChar(128)
  publishedAt       DateTime?
  effectiveFrom     DateTime?
  retiredAt         DateTime?
  createdAt         DateTime        @default(now())
  consentDocument   ConsentDocument @relation(fields: [consentDocumentId], references: [id], onDelete: Restrict)
  market            Market          @relation(fields: [marketId], references: [id], onDelete: Restrict)
  userConsents      UserConsent[]

  @@unique([consentDocumentId, marketId, version, language])
  @@index([marketId, language, publishedAt, effectiveFrom])
}

model UserConsent {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  consentVersionId String         @db.Uuid
  accepted         Boolean
  recordedAt       DateTime       @default(now())
  withdrawnAt      DateTime?
  source           String         @db.VarChar(80)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  consentVersion   ConsentVersion @relation(fields: [consentVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, consentVersionId])
  @@index([userId, recordedAt])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  operation   String   @db.VarChar(160)
  key         String   @db.VarChar(160)
  actorId     String   @db.Uuid
  requestHash String   @db.Char(64)
  resultType  String   @db.VarChar(120)
  resultId    String   @db.VarChar(160)
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([operation, key])
  @@index([actorId, createdAt])
}

model PartnerService {
  id             String                 @id @default(uuid()) @db.Uuid
  key            String                 @unique @db.VarChar(120)
  name           String                 @db.VarChar(200)
  status         ServiceStatus          @default(DRAFT)
  externalUrl    String?                @db.VarChar(2048)
  transitionRule String?                @db.Text
  legalNotice    String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  markets        PartnerServiceMarket[]
  opportunities  Opportunity[]
  tasks          TaskDefinition[]
  promocodes     Promocode[]
}

model PartnerServiceMarket {
  partnerServiceId String         @db.Uuid
  marketId         String         @db.Uuid
  status           ServiceStatus  @default(DRAFT)
  termsVersion     String?        @db.VarChar(80)
  availableFrom    DateTime?
  availableUntil   DateTime?
  partnerService   PartnerService @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
  market           Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@id([partnerServiceId, marketId])
  @@index([marketId, status])
}

model Opportunity {
  id               String                   @id @default(uuid()) @db.Uuid
  key              String                   @unique @db.VarChar(140)
  type             OpportunityType
  title            String                   @db.VarChar(240)
  description      String                   @db.Text
  status           PublicationStatus        @default(DRAFT)
  partnerServiceId String?                  @db.Uuid
  instructionId    String?                  @db.Uuid
  forecastId       String?                  @db.Uuid
  nextStep         String                   @db.VarChar(500)
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  partnerService   PartnerService?          @relation(fields: [partnerServiceId], references: [id], onDelete: Restrict)
  instruction      Instruction?             @relation(fields: [instructionId], references: [id], onDelete: Restrict)
  forecast         Forecast?                @relation(fields: [forecastId], references: [id], onDelete: Restrict)
  audiences        OpportunityAudience[]
  eligibility      OpportunityEligibility[]
  taskDefinitions  TaskDefinition[]
  promocodes       Promocode[]

  @@index([status, type])
  @@index([partnerServiceId, status])
  @@index([instructionId])
  @@index([forecastId])
}

model OpportunityAudience {
  opportunityId String      @db.Uuid
  productRole   ProductRole
  marketId      String      @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  market        Market      @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@id([opportunityId, productRole, marketId])
  @@index([productRole, marketId])
}

model OpportunityEligibility {
  id             String            @id @default(uuid()) @db.Uuid
  opportunityId  String            @db.Uuid
  userId         String            @db.Uuid
  status         EligibilityStatus
  reasonCode     String            @db.VarChar(120)
  explanation    String            @db.VarChar(500)
  policyVersion  String            @db.VarChar(80)
  idempotencyKey String            @unique @db.VarChar(160)
  evaluatedAt    DateTime          @default(now())
  validUntil     DateTime?
  opportunity    Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, evaluatedAt])
  @@index([opportunityId, status, evaluatedAt])
}

model Instruction {
  id            String               @id @default(uuid()) @db.Uuid
  key           String               @unique @db.VarChar(140)
  title         String               @db.VarChar(240)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  versions      InstructionVersion[]
  opportunities Opportunity[]
}

model InstructionVersion {
  id            String                @id @default(uuid()) @db.Uuid
  instructionId String                @db.Uuid
  version       Int
  status        PublicationStatus     @default(DRAFT)
  title         String                @db.VarChar(240)
  summary       String                @db.Text
  language      LanguageCode
  contentHash   String                @db.VarChar(128)
  createdById   String                @db.Uuid
  publishedAt   DateTime?
  supersedesId  String?               @db.Uuid
  createdAt     DateTime              @default(now())
  instruction   Instruction           @relation(fields: [instructionId], references: [id], onDelete: Restrict)
  supersedes    InstructionVersion?   @relation("InstructionVersionChain", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy  InstructionVersion[]  @relation("InstructionVersionChain")
  sections      InstructionSection[]
  steps         InstructionStep[]
  audiences     InstructionAudience[]
  taskVersions  TaskVersion[]

  @@unique([instructionId, version, language])
  @@index([status, publishedAt])
  @@index([createdById])
}

model InstructionSection {
  id                   String             @id @default(uuid()) @db.Uuid
  instructionVersionId String             @db.Uuid
  position             Int
  title                String             @db.VarChar(240)
  body                 String             @db.Text
  instructionVersion   InstructionVersion @relation(fields: [instructionVersionId], references: [id], onDelete: Cascade)

  @@unique([instructionVersionId, position])
}

model InstructionStep {
  id                   String             @id @default(uuid()) @db.Uuid
  instructionVersionId String             @db.Uuid
  position             Int
  title                String             @db.VarChar(240)
  body                 String             @db.Text
  isRequired           Boolean            @default(true)
  warning              String?            @db.Text
