  @@index([responsibleManagerId])
  @@index([sequenceOrder])
}

model TaskVersion {
  id                        String                @id @default(uuid()) @db.Uuid
  taskDefinitionId          String                @db.Uuid
  version                   Int
  status                    PublicationStatus     @default(DRAFT)
  title                     String                @db.VarChar(240)
