# Безопасный шаблон локальной конфигурации. Не используйте эти значения в production.
NODE_ENV=development
APP_NAME=VX House
LOG_LEVEL=info
DATABASE_URL=postgresql://vx_house:change-me@localhost:5432/vx_house?schema=public
DIRECT_URL=postgresql://vx_house:change-me@localhost:5432/vx_house?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-another-distinct-random-secret
DATA_PROTECTION_KEY_ID=local-v1
DATA_PROTECTION_KEY=replace-with-base64url-encoded-32-byte-key
AUTH_SESSION_IDLE_TTL_SECONDS=604800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_SESSION_REFRESH_AFTER_SECONDS=86400
BRUTE_FORCE_IDENTIFIER_LIMIT=5
BRUTE_FORCE_IDENTIFIER_WINDOW_SECONDS=900
BRUTE_FORCE_NETWORK_LIMIT=50
BRUTE_FORCE_NETWORK_WINDOW_SECONDS=900
HEALTH_CHECK_TIMEOUT_MS=2000
EMAIL_VERIFICATION_SECRET=replace-with-a-distinct-random-secret
EMAIL_PROVIDER=development
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_MAX_ACTIVE=2
TRUST_PROXY_HEADERS=false
