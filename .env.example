# Public deployment
NODE_ENV=production
APP_NAME=VX House
NEXT_PUBLIC_SITE_URL=https://example.com
APP_PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HEADERS=true

# PostgreSQL container
POSTGRES_DB=vx_house
POSTGRES_USER=vx_house
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_TLS_CERT_DAYS=3650

# Keep DATABASE_URL and DIRECT_URL synchronized with the PostgreSQL values above.
# If the password contains URL-reserved characters, URL-encode it here.
DATABASE_URL=postgresql://vx_house:replace-with-a-long-url-safe-password@postgres:5432/vx_house?sslmode=require
DIRECT_URL=postgresql://vx_house:replace-with-a-long-url-safe-password@postgres:5432/vx_house?sslmode=require

# Generate every secret independently. Never reuse a value.
SESSION_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-a-different-32-character-secret
EMAIL_VERIFICATION_SECRET=replace-with-another-32-character-secret
DATA_PROTECTION_KEY_ID=production.primary.v1
# Exactly 32 random bytes encoded as unpadded base64url (43 characters).
DATA_PROTECTION_KEY=replace-with-a-43-character-base64url-key

# Session and abuse-protection defaults
AUTH_SESSION_IDLE_TTL_SECONDS=604800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_SESSION_REFRESH_AFTER_SECONDS=86400
BRUTE_FORCE_IDENTIFIER_LIMIT=5
BRUTE_FORCE_IDENTIFIER_WINDOW_SECONDS=900
BRUTE_FORCE_NETWORK_LIMIT=50
BRUTE_FORCE_NETWORK_WINDOW_SECONDS=900
HEALTH_CHECK_TIMEOUT_MS=2000

# The current server supports disabled or development. Production must use disabled.
EMAIL_PROVIDER=disabled
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_MAX_ACTIVE=2
